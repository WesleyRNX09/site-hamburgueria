# Copie este arquivo para .env, na mesma pasta, e preencha os dois primeiros valores.
# O .env fica somente no computador da loja e nunca deve ser commitado.

# Endereco do sistema, igual ao que voce digita no navegador para abrir o painel.
# Em teste local, use http://localhost:3001.
PRINT_AGENT_URL=https://sualoja.exemplo.com.br

# Token gerado em Admin -> Impressoras -> Gerar dispositivo.
# Ele aparece uma unica vez na tela: se perder, gere outro e revogue o antigo.
# Este arquivo e um exemplo versionado: o token de verdade vai no .env, nunca aqui.
PRINT_AGENT_TOKEN=cole-aqui-o-token-do-dispositivo

# De quanto em quanto tempo consultar a fila, em milissegundos (minimo 1000).
PRINT_AGENT_INTERVAL_MS=5000

# Tempo maximo esperando a impressora responder, em milissegundos.
PRINT_AGENT_PRINTER_TIMEOUT_MS=10000

# Tempo maximo esperando o servidor responder, em milissegundos.
PRINT_AGENT_HTTP_TIMEOUT_MS=15000
