# Copie este arquivo para .env e substitua os valores indicados.

# Banco PostgreSQL (Supabase). Painel do Supabase -> botao "Connect" ->
# "Session pooler" -> copie a URI e troque [YOUR-PASSWORD] pela senha do banco.
# Use o Session pooler (porta 5432): funciona em IPv4 (a conexao direta
# db.<projeto>.supabase.co e so IPv6 no plano gratuito) e mantem as
# configuracoes da sessao que o backend usa. O Transaction pooler (porta 6543)
# NAO e suportado. Senha com caractere especial (@ # / ? %) precisa ir
# codificada na URL: @ vira %40, # vira %23, / vira %2F, ? vira %3F, % vira %25.
DATABASE_URL=postgresql://postgres.SEU-PROJETO:troque-pela-senha-do-banco@aws-0-sa-east-1.pooler.supabase.com:5432/postgres

# TLS com o certificado validado (nunca desligado). Baixe o certificado em
# Supabase -> Project Settings -> Database -> SSL Configuration -> Download
# certificate, salve fora do Git (ex.: certificados/supabase-ca.crt) e aponte
# o caminho aqui. Em um PostgreSQL local sem TLS, use DB_SSL=false.
DB_SSL=true
DB_SSL_CA=certificados/supabase-ca.crt
DB_CONNECTION_LIMIT=10

# Alternativa a DATABASE_URL: as partes separadas (DATABASE_URL vence se as
# duas formas estiverem preenchidas).
# DB_HOST=aws-0-sa-east-1.pooler.supabase.com
# DB_PORT=5432
# DB_USER=postgres.SEU-PROJETO
# DB_PASSWORD=troque-pela-senha-do-banco
# DB_NAME=postgres

ADMIN_USER=admin
ADMIN_EMAIL=admin@hamburgueria.com
ADMIN_NAME=Administrador
ADMIN_PASSWORD=troque-por-uma-senha-administrativa-segura

# Assinatura das sessoes (admin, garcom e superadmin). Minimo de 32 bytes.
# Sem esta variavel o servidor gera um segredo aleatorio a cada inicializacao,
# e toda sessao aberta cai ("Sua sessao e invalida ou expirou") quando a API
# reinicia -- o que acontece a cada alteracao em server/ durante o dev.
# Gere o seu com: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=troque-por-um-segredo-local-com-32-bytes-ou-mais

# Hosts onde a API do superadmin (/api/superadmin/*) responde, separados por
# virgula (so o nome do host, sem https:// nem caminho; a porta e ignorada).
# Vazio = responde em qualquer host (bom para o dev local). EM PRODUCAO,
# DEFINA com o dominio do painel global: fora da lista a API responde 404.
SUPERADMIN_HOSTS=

# Dados demonstrativos sao habilitados automaticamente em desenvolvimento.
SEED_DEMO_DATA=1
SYNC_ADMIN_CREDENTIALS=0
