# Copie este arquivo para .env e substitua os valores indicados.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_CREATE_IF_MISSING=1
DB_USER=hamburgueria_app
DB_PASSWORD=troque-por-uma-senha-local-segura
DB_NAME=hamburgueria

ADMIN_USER=admin
ADMIN_EMAIL=admin@hamburgueria.com
ADMIN_NAME=Administrador
ADMIN_PASSWORD=troque-por-uma-senha-administrativa-segura

# Assinatura das sessoes (admin, garcom e superadmin). Minimo de 32 bytes.
# Sem esta variavel o servidor gera um segredo aleatorio a cada inicializacao,
# e toda sessao aberta cai ("Sua sessao e invalida ou expirou") quando a API
# reinicia -- o que acontece a cada alteracao em server/ durante o dev.
# Gere o seu com: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=troque-por-um-segredo-local-com-32-bytes-ou-mais

# Dados demonstrativos sao habilitados automaticamente em desenvolvimento.
SEED_DEMO_DATA=1
SYNC_ADMIN_CREDENTIALS=0
