PORT=3001
# Em produção, defina NODE_ENV=production e provisione o banco antes de iniciar.
# NODE_ENV=production
# URL pública HTTPS usada no sitemap e nos metadados do frontend.
# PUBLIC_SITE_URL=https://pedidos.seudominio.com.br
# VITE_PUBLIC_URL=https://pedidos.seudominio.com.br
# Origens autorizadas a acessar a API, separadas por vírgula. Em produção, não use *.
# CORS_ORIGINS=https://pedidos.seudominio.com.br

# MySQL Server usado pelo MySQL Workbench
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=hamburgueria_app
DB_PASSWORD=qrb01050924
DB_NAME=hamburgueria
DB_CONNECTION_LIMIT=10
# Diretório persistente fora do release e retenção dos backups locais.
# BACKUP_PATH=C:\backups\hamburgueria
# BACKUP_RETENTION_DAYS=14

ADMIN_USER=admin
ADMIN_EMAIL=admin@hamburgueria.com
ADMIN_NAME=Administrador
ADMIN_PASSWORD=troque-esta-senha
# Use 1 somente para redefinir a conta administrativa inicial no próximo boot.
# Remova/desative depois, para que trocas de senha feitas no painel sejam preservadas.
# SYNC_ADMIN_CREDENTIALS=0

# Somente para ambientes descartáveis. Tokens são sempre gerados aleatoriamente.
# SEED_DEMO_DATA=1
# DEMO_WAITER_PIN=246810

# Caminho opcional. Por padrão, fica dentro da pasta server.
# UPLOADS_PATH=server/uploads
