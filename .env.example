# Aplicação
NODE_ENV=development
PORT=3001

# MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=hamburgueria_app
DB_PASSWORD=
DB_NAME=hamburgueria
DB_CONNECTION_LIMIT=10
DB_SSL=false
# Informe o conteúdo PEM do certificado ou um caminho relativo/absoluto.
DB_SSL_CA=

# Primeiro administrador da instalação atual.
# Estas variáveis são lidas somente pelos comandos explícitos de preparação
# e criação do administrador; o servidor não cria usuários no startup.
ADMIN_USER=admin
ADMIN_EMAIL=admin@exemplo.com
ADMIN_NAME=Administrador
ADMIN_PASSWORD=
SYNC_ADMIN_CREDENTIALS=0

# Superadministrador global. Lido somente por `npm run criar-superadmin`.
SUPERADMIN_USER=superadmin
SUPERADMIN_EMAIL=hello.wesleyberaldi@gmail.com
SUPERADMIN_NAME=wesleyberaldi
SUPERADMIN_PASSWORD=@Qrb01050924
SYNC_SUPERADMIN_CREDENTIALS=0

# Dados demonstrativos: use somente em ambiente descartável.
SEED_DEMO_DATA=0
DEMO_WAITER_PIN=

# Aplicação web e segurança de origem
PUBLIC_SITE_URL=
VITE_PUBLIC_URL=
VITE_API_URL=
CORS_ORIGINS=
DOMINIO_PRINCIPAL=
# Slug usado apenas ao acessar localhost/127.0.0.1.
TENANT_DESENVOLVIMENTO=estabelecimento-padrao
# Segredo aleatório com pelo menos 32 bytes para assinar os tokens de acesso.
JWT_SECRET=

# Persistência de imagens
UPLOADS_PATH=server/uploads
